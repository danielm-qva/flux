{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "updater:default",
    "process:allow-restart"
    ,"dialog:allow-open"
    ,"dialog:allow-save"
    ,"fs:allow-read-text-file"
    ,"fs:allow-write-text-file"
  ]
}
